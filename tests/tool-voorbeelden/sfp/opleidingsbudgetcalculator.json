 "reken": [
  {
   "id": "fte",
   "formule": "omlaag(medewerkers)"
  },
  {
   "id": "totaal",
   "formule": "loonsom * sector.pct / 100"
  },
  {
   "id": "perfte",
   "formule": "afronden(totaal / fte)"
  }
 ],
 "controles": [
  {
   "formule": "niet (fte >= 1)",
   "melding": "Vul een geldig aantal medewerkers in (minstens 1).",
   "stap": 1
  },
  {
   "formule": "niet (loonsom >= 1000)",
