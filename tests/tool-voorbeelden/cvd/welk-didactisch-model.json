  "uitslagen": {
    "van_gelder": {
      "titel": "Van Gelder (didactisch analyse-model)",
      "tekst": "Het Van Gelder-model analyseert een les of training in zeven samenhangende didactische componenten: doelen, beginsituatie, leerstof, werkvormen, media, sociale vormen en evaluatie. Het is sterk voor het analyseren van een bestaande of geplande les.",
      "lijsten": {
        "stappenplan": [
          "Beschrijf de doelen en beginsituatie van de lerenden.",
          "Kies de leerstof en de werkvormen die passen bij de doelen.",
          "Bepaal de media en de sociale vorm (klassikaal, in groepjes, individueel).",
          "Plan de evaluatiemomenten en check de samenhang tussen alle zeven componenten."
        ],
        "bestandsnaam": [
          "van-gelder-didactisch-analyse-model"
        ]
      }
    },
    "addie": {
      "titel": "ADDIE",
      "tekst": "ADDIE is een procesmodel voor instructional design: Analyse, Design, Development, Implementation, Evaluation. Sterk voor het ontwerpen van een complete leertraining van begin tot eind, in een iteratieve cyclus.",
      "lijsten": {
        "stappenplan": [
          "Analyse: breng doelgroep, doelen en context in kaart.",
          "Design: ontwerp de leeractiviteiten, structuur en beoordeling.",
          "Development: ontwikkel materialen, opdrachten en media.",
          "Implementation + Evaluation: voer uit, evalueer en pas aan voor de volgende iteratie."
        ],
        "bestandsnaam": [
          "addie"
        ]
      }
    },
    "fourcid": {
      "titel": "4C/ID (Vier-Componenten Instructie-Ontwerp)",
      "tekst": "Het 4C/ID-model van Van Merrienboer ontwerpt training rondom complexe vaardigheden. Centraal staan leertaken (whole tasks), aangevuld met ondersteunende informatie, procedurele informatie en deeltaak-oefening.",
      "lijsten": {
        "stappenplan": [
          "Identificeer de complexe vaardigheid die geleerd moet worden.",
          "Ontwerp leertaken in oplopende moeilijkheidsgraad (van eenvoudig naar complex).",
          "Voeg ondersteunende en procedurele informatie toe op het juiste moment in de leertaak.",
          "Plan deeltaak-oefening voor onderdelen die geautomatiseerd moeten worden."
        ],
        "bestandsnaam": [
          "4cid-vier-componenten-instructie-ontwerp"
        ]
      }
    },
    "backward": {
      "titel": "Backward Design",
      "tekst": "Backward Design (Wiggins en McTighe) begint bij de eindprestatie: wat moet de lerende straks aantoonbaar kunnen? Daarvandaan ontwerp je terug naar de bewijsstukken en pas dan naar de leeractiviteiten.",
      "lijsten": {
        "stappenplan": [
          "Definieer de eindprestatie en de bijbehorende leerdoelen.",
          "Bepaal welk bewijs aantoont dat het doel is bereikt (toets, opdracht, product).",
          "Ontwerp leeractiviteiten die rechtstreeks naar dat bewijs werken.",
          "Toets de coherentie: zit elke leeractiviteit op het pad naar de eindprestatie?"
        ],
        "bestandsnaam": [
          "backward-design"
        ]
      }
    },
    "tpack": {
      "titel": "TPACK",
      "tekst": "TPACK (Technological Pedagogical Content Knowledge) is een model voor onderwijs met technologie. Het balanceert drie kennisdomeinen: inhoud, pedagogiek en technologie. Sterk voor online of hybride leren.",
      "lijsten": {
        "stappenplan": [
          "Bepaal de inhoudelijke leerdoelen (Content Knowledge).",
          "Kies pedagogische strategieen die passen (Pedagogical Knowledge).",
          "Selecteer technologie die zowel inhoud als pedagogiek versterkt (Technological Knowledge).",
          "Toets de integratie: ondersteunt de technologie de leerdoelen daadwerkelijk?"
        ],
        "bestandsnaam": [
          "tpack"
        ]
      }
    },
    "direct_instruction": {
      "titel": "Direct Instruction (Rosenshine)",
      "tekst": "Direct Instruction met de tien principes van Rosenshine staat voor expliciete, gestructureerde uitleg, gevolgd door begeleide oefening en zelfstandige oefening. Sterk voor het overdragen van duidelijke kennis.",
      "lijsten": {
        "stappenplan": [
          "Begin met een korte herhaling van eerder geleerde stof.",
          "Geef nieuwe stof in kleine stappen, met heldere uitleg en voorbeelden.",
          "Stel veel vragen en check het begrip; pas instructie aan op antwoorden.",
          "Begeleid de eerste oefening, geef feedback, laat daarna zelfstandig oefenen."
        ],
        "bestandsnaam": [
          "direct-instruction-rosenshine"
        ]
      }
    },
    "bik": {
      "titel": "BIK-model",
      "tekst": "BIK (Bekend, Interessant, Kapstok) is een didactisch start-model voor de opening van een les: maak het onderwerp eerst Bekend, dan Interessant, en bied een Kapstok aan om de inhoud aan te hangen.",
      "lijsten": {
        "stappenplan": [
          "Bekend: knoop het onderwerp aan iets dat de lerenden al kennen.",
          "Interessant: maak het onderwerp persoonlijk relevant of verrassend.",
          "Kapstok: bied een overzichtelijke structuur waarin de inhoud past.",
          "Verwijs gedurende de les terug naar de kapstok om samenhang te tonen."
        ],
        "bestandsnaam": [
          "bik-model"
        ]
      }
    }
  },
