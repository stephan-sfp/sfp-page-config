    "onder-druk": {
      "titel": "Alle drie onder druk",
      "tekst": "Je drie pijlers staan onder druk. Dit is een signaal om je situatie eens grondig tegen het licht te houden. Wat zou er voor jou moeten veranderen om de waarde van je werk terug te krijgen?",
      "lijsten": {
        "pdfnaam": [
          "alle-drie-onder-druk"
        ]
      }
    },
    "autonomie": {
      "titel": "Tips om autonomie te versterken",
      "lijsten": {
        "tips": [
          "Vraag bewust naar keuzemogelijkheden voor je een taak aanneemt. \"Welke aanpak heeft je voorkeur?\" is een sterke opener.",
          "Kies elke week 1 taak die volledig naar jouw eigen invulling mag. Er kan vaak meer dan je denkt.",
          "Bespreek momenten waarop je druk ervaart met je leidinggevende of opdrachtgever en onderhandel waar je echt zelf kunt sturen."
        ]
      }
    },
    "competentie": {
      "titel": "Tips om competentie te versterken",
      "lijsten": {
        "tips": [
          "Maak je groei zichtbaar: noteer wekelijks 1 concreet ding dat je beter kunt dan een maand geleden.",
          "Vraag actief om feedback van een collega of leidinggevende: \"Wat ging hier goed, wat kan beter?\"",
          "Kies een leerdoel dat net buiten je comfortzone ligt maar haalbaar is. Te makkelijk geeft geen competentiegevoel, te moeilijk geeft frustratie."
        ]
      }
    },
    "verbondenheid": {
      "titel": "Tips om verbondenheid te versterken",
      "lijsten": {
        "tips": [
          "Plan 1x per week een check-in van 15 minuten met iemand uit je werkkring zonder agenda. Het gesprek zelf is de waarde.",
          "Deel een keer een twijfel of fout met een collega. Kwetsbaarheid creëert verbondenheid sneller dan succes.",
          "Kies 2-3 mensen van wie je energie krijgt en investeer bewust in die relaties."
        ]
      }
    }
