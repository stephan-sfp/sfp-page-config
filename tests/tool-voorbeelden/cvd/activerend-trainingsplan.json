 "reken": [
  {
   "id": "som",
   "formule": "som(pct_activatie, pct_theorie, pct_toepassing, pct_reflectie)"
  },
  {
   "id": "act",
   "formule": "afronden(tijd * pct_activatie / 100)"
  },
  {
   "id": "theo",
   "formule": "afronden(tijd * pct_theorie / 100)"
  },
  {
   "id": "toe",
   "formule": "afronden(tijd * pct_toepassing / 100)"
  },
  {
   "id": "refl",
   "formule": "tijd - act - theo - toe"
  },
  {
   "id": "start_theo",
   "formule": "act"
  },
  {
   "id": "start_toe",
   "formule": "act + theo"
  },
  {
   "id": "start_refl",
   "formule": "act + theo + toe"
  }
 ],
