    },
    {
     "label": "Reflectie",
     "waarde": "refl"
    }
   ],
   "formaat": "na: min"
  },
  {
   "type": "tekst",
   "kop": "Fase 1. Activatie",
   "tekst": "0{=0|klok} – 0{act|klok} · {act} min"
  },
  {
   "type": "gegevens",
