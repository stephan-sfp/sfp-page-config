 "resultaat_kop": "Trainingsplan: {onderwerp|anders:Activatiecurve-training}",
 "resultaat_intro": "{groep|bank:groeplabel} · {tijd|bank:tijdlabel}{doelgroep|voor: · }",
 "uitvoer": [
  {
   "type": "gegevens",
   "regels": [
    {
     "label": "Leerdoel",
     "tekst": "{doel}"
    }
   ]
  },
  {
   "type": "verdeling",
   "delen": [
    {
     "label": "Activatie",
     "waarde": "act"
    },
    {
     "label": "Theorie",
