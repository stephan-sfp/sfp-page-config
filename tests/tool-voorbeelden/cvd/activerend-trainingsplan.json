    {
     "label": "Doel",
     "tekst": "Voorkennis ophalen, betrokkenheid creëren"
    },
    {
     "label": "Rol trainer",
     "tekst": "Ophalen, niet uitleggen"
    },
    {
     "label": "Voorkennis ophalen",
     "tekst": "{act_voorkennis}"
    },
    {
     "label": "Houding peilen",
     "tekst": "{act_houding}"
    }
   ]
  },
  {
   "type": "kaarten",
   "kop": "Aanbevolen werkvormen",
   "bank": "werkvormen",
   "filter": "item.fase = \"activatie\" en item.tijd <= act + 5 en item.min <= groep.max en item.max >= groep.min",
   "voorkeur": {
    "formule": "bevat(item.doel, doeltype)",
    "minimaal": 2
   },
   "terugval": {
    "filter": "item.fase = \"activatie\"",
    "aantal": 2
   },
   "sorteer": "abs(item.tijd - act / 2)",
   "aantal": "3",
   "kaartkop": "{item.naam} · {item.tijd} min",
   "inhoud": [
