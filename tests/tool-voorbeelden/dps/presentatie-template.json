 "bewerkbaar": true,
 "uitvoer": [
  {
   "type": "kaarten",
   "bank": "structuren",
   "pad": [
    "{doel}"
   ],
   "aantal": "n",
   "kaartkop": "{nr}. {item.titel}",
   "inhoud": [
    {
     "type": "tekst",
     "tekst": "{=omlaag((nr - 1) * duur * 60 / n)|minsec} - {=omlaag(nr * duur * 60 / n)|minsec} min"
    },
    {
     "type": "lijst",
     "items": [
      "{item.p1}",
      "{item.p2}",
      "{item.p3}"
     ]
    },
    {
     "type": "tekst",
     "tekst": "{item.concept}",
     "als": {
      "formule": "niet (bevat(item.concept, \"de luisteraar\"))"
     }
    },
    {
     "type": "tekst",
     "tekst": "{item.voor}{doelgroep|anders:de luisteraar}{item.na}",
     "als": {
      "formule": "bevat(item.concept, \"de luisteraar\")"
     }
    }
   ]
  }
 ],
